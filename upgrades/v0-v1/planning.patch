+      "| [From shipped](features/shipped/dupe/) | 2020-01-02 |\n"
+    )
+
+    assert_equal "From active", found["dupe"]
+    assert_equal "From active", found["features/active/dupe"]
+    assert_equal "From shipped", found["features/shipped/dupe"]

#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerate the GENERATED INDEX block in README.md from the feature tree.
# Lifecycle comes from the path segment. Nothing else is read from the folder.

# This repo pins its Ruby in .ruby-version; the library uses 3.x syntax, so
# fail with a sentence rather than a parse dump when an older Ruby is in PATH.
if RUBY_VERSION < "3.0"
  abort "bin/index: needs Ruby 3.0+, found #{RUBY_VERSION}. " \
        "Run it from the repo root so .ruby-version applies."
end

require_relative "lib/planning"

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TEXT
    usage: bin/index [--check]

      (no args)  rewrite the GENERATED INDEX block in README.md
      --check    exit 1 if the block would change; write nothing
  TEXT
  exit 0
end

mode = :write
ARGV.each do |arg|
  case arg
  when "--check" then mode = :check
  else abort "bin/index: unknown argument #{arg.inspect} (try --help)"
  end
end

begin
  updated = Planning::Index.render
rescue => e
  abort "bin/index: #{e.message}"
end

path = Planning::Index.readme_path
current = File.read(path, encoding: "UTF-8")

if current == updated
  puts "bin/index: README.md is up to date."
  exit 0
end

if mode == :check
  have = current.lines
  want = updated.lines
  at = (0...[have.length, want.length].max).find { |i| have[i] != want[i] }
  warn "bin/index: README.md is out of date (first difference at line #{at.to_i + 1}); run bin/index"
  warn "  have: #{have[at].to_s.chomp.inspect}"
  warn "  want: #{want[at].to_s.chomp.inspect}"
  exit 1
end

File.write(path, updated)
puts "bin/index: rewrote the generated index in README.md."

#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerate INDEX.md from the feature tree. The whole file is generated.
# Lifecycle comes from the path segment. Nothing else is read from the folder.

# This repo pins its Ruby in .ruby-version; the library uses 3.x syntax, so
# fail with a sentence rather than a parse dump when an older Ruby is in PATH.
if RUBY_VERSION < "3.0"
  abort "bin/index: needs Ruby 3.0+, found #{RUBY_VERSION}. " \
        "Run it from the repo root so .ruby-version applies."
end

require_relative "lib/planning"

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TEXT
    usage: bin/index [--check]

      (no args)  write INDEX.md from the feature tree
      --check    exit 1 if INDEX.md is missing or would change; write nothing
  TEXT
  exit 0
end

mode = :write
ARGV.each do |arg|
  case arg
  when "--check" then mode = :check
  else abort "bin/index: unknown argument #{arg.inspect} (try --help)"
  end
end

begin
  updated = Planning::Index.render
rescue => e
  abort "bin/index: #{e.message}"
end

path = Planning::Index.index_path
exists = File.exist?(path)
current = Planning::Index.current

if exists && current == updated.text
  puts "bin/index: INDEX.md is up to date."
  exit 0
end

if mode == :check
  # A repo that has only just adopted this tooling has no INDEX.md at all.
  # That is a different message from a stale one, and not a stack trace.
  unless exists
    warn "bin/index: INDEX.md is missing; run bin/index"
    exit 1
  end

  have = current.lines
  want = updated.text.lines
  at = (0...[have.length, want.length].max).find { |i| have[i] != want[i] }
  warn "bin/index: INDEX.md is out of date (first difference at line #{at.to_i + 1}); run bin/index"
  warn "  have: #{have[at].to_s.chomp.inspect}"
  warn "  want: #{want[at].to_s.chomp.inspect}"
  exit 1
end

File.write(path, updated.text)
puts "bin/index: #{exists ? "rewrote" : "created"} INDEX.md."

# Preserving a hand-edited title is invisible in the diff when it works, and
# indistinguishable from losing it when it does not. So say which happened.
unless updated.kept.empty?
  puts "  kept #{updated.kept.length} title#{"s" unless updated.kept.length == 1} already in the index"
end
unless updated.derived.empty?
  puts "  derived #{updated.derived.length} from the folder: #{updated.derived.join(", ")}"
end
